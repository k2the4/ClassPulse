generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
}

enum SubjectType {
  THEORY
  LAB
}

model College {
  id          String       @id @default(cuid())
  name        String
  departments Department[]
  users       User[]
  createdAt   DateTime     @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String
  college   College  @relation(fields: [collegeId], references: [id])
  collegeId String
  classes   Class[]
  createdAt DateTime @default(now())
}

model User {
  id                   String              @id @default(cuid())
  name                 String
  email                String              @unique
  authUserId            String?             @unique @db.Uuid
  role                 Role                @default(TEACHER)
  college              College             @relation(fields: [collegeId], references: [id])
  collegeId            String
  assignments          Assignment[]
  proctorOf            Class[]            @relation("Proctor")
  classAccess          ClassAccess[]
  attendanceSessions   AttendanceSession[]
  createdAt            DateTime            @default(now())
}

model Class {
  id            String        @id @default(cuid())
  department    Department    @relation(fields: [departmentId], references: [id])
  departmentId  String
  program       String
  academicYear  String
  year          String
  semester      Int
  proctor       User?         @relation("Proctor", fields: [proctorId], references: [id])
  proctorId     String?
  sections      Section[]
  classAccess   ClassAccess[]
  createdAt     DateTime      @default(now())
}

model ClassAccess {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   String
  createdAt DateTime @default(now())

  @@unique([teacherId, classId])
  @@index([classId])
  @@index([teacherId])
}

model Section {
  id                 String              @id @default(cuid())
  name               String
  class              Class               @relation(fields: [classId], references: [id])
  classId            String
  strength           Int                 @default(0)
  students           Student[]
  subjects           Subject[]
  sheetLink          SheetLink?
  snapshots          AnalysisSnapshot[]
  attendanceSessions AttendanceSession[]
  createdAt          DateTime            @default(now())

  @@unique([classId, name])
}

model Student {
  id                 String              @id @default(cuid())
  enrollmentNo       String
  name               String
  email              String
  section            Section             @relation(fields: [sectionId], references: [id])
  sectionId          String
  attendanceRecords  AttendanceRecord[]
  createdAt          DateTime            @default(now())

  @@unique([sectionId, enrollmentNo])
}

model Subject {
  id                 String              @id @default(cuid())
  name               String
  code               String
  type               SubjectType         @default(THEORY)
  section            Section             @relation(fields: [sectionId], references: [id])
  sectionId          String
  sheetLink          SheetLink?
  assignments        Assignment[]
  snapshots          AnalysisSnapshot[]
  attendanceSessions AttendanceSession[]
  createdAt          DateTime            @default(now())

  @@unique([sectionId, code])
}

model Assignment {
  id        String   @id @default(cuid())
  teacher   User     @relation(fields: [teacherId], references: [id])
  teacherId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@unique([subjectId])
}

model SheetLink {
  id         String   @id @default(cuid())
  section    Section? @relation(fields: [sectionId], references: [id])
  sectionId  String?  @unique
  subject    Subject? @relation(fields: [subjectId], references: [id])
  subjectId  String?  @unique
  sheetId    String
  gid        String?
  lastSyncAt DateTime?
}

model AnalysisSnapshot {
  id         String   @id @default(cuid())
  subject    Subject? @relation(fields: [subjectId], references: [id])
  subjectId  String?
  section    Section? @relation(fields: [sectionId], references: [id])
  sectionId  String?
  computedAt DateTime @default(now())
  data       Json

  @@index([subjectId, computedAt])
  @@index([sectionId, computedAt])
}

model AttendanceSession {
  id         String             @id @default(cuid())
  section    Section            @relation(fields: [sectionId], references: [id])
  sectionId  String
  subject    Subject            @relation(fields: [subjectId], references: [id])
  subjectId  String
  teacher    User               @relation(fields: [teacherId], references: [id])
  teacherId  String
  date       DateTime           @db.Date
  slot       String
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([sectionId, subjectId, date, slot])
  @@index([teacherId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  student   Student           @relation(fields: [studentId], references: [id])
  studentId String
  present   Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
}
